      "checkConstraints": {
        "chk_expense_sign": {
          "name": "chk_expense_sign",
          "value": "kind <> 'expense' OR amount_cents < 0"
        },
        "chk_income_sign": {
          "name": "chk_income_sign",
          "value": "kind <> 'income' OR amount_cents > 0"
        },
        "chk_transfer_zero": {
          "name": "chk_transfer_zero",
          "value": "kind <> 'transfer' OR amount_cents = 0"
        },
        "chk_expense_source": {
          "name": "chk_expense_source",
          "value": "kind <> 'expense' OR source IS NOT NULL"
        },
        "chk_card_source": {
          "name": "chk_card_source",
          "value": "source IS DISTINCT FROM 'card' OR card_id IS NOT NULL"
        },
        "chk_transfer_fields": {
          "name": "chk_transfer_fields",
          "value": "kind <> 'transfer' OR (transfer_from_account_id IS NOT NULL AND transfer_to_account_id IS NOT NULL AND transfer_value_cents > 0 AND transfer_from_account_id <> transfer_to_account_id)"
        },
        "chk_parcela_pair": {
          "name": "chk_parcela_pair",
          "value": "(installment_group_id IS NULL) = (parcela_no IS NULL)"
        }
      },
