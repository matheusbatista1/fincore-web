{
  "name": "fincore-web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "FinCore — personal finance management web app (BR).",
  "author": "Matheus dos Santos Batista",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:domain": "vitest run src/domain --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "push:keys": "tsx scripts/generate-vapid-keys.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "~1.60.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
