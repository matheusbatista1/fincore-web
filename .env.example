# ============================================================================
# FinCore — environment variables. Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ============================================================================

# --- Supabase (public, safe for the client) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Supabase (server-only — NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --- Postgres connection strings ---
# Runtime uses the POOLED connection (port 6543, transaction mode).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres"
# Migrations use the DIRECT/session connection (port 5432).
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Observability (optional) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
